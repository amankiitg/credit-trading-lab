venv/
__pycache__/
data/*.csv
# Except this one. The hand-curated distribution override is data the cron needs,
# not scratch output: Render builds from the repo and has no persistent disk, so a
# file that stays ignored does not exist in the container that refreshes the cache.
!data/distributions_override.csv

# Written by signals.dividends.ingest: the date the distribution cache was refreshed.
# It changes every session, and a container with no marker is correctly read as never
# refreshed here rather than as fresh.
data/raw/dividends_as_of.json

# One-off backups taken before a data correction: evidence, not source. They are
# written by hand and read by a human, so they never belong in the repo.
backups/

# credentials -- never commit
.env
.env.*
.streamlit/secrets.toml

# C++ build artifacts (sprint v2)
build/
cpp/build/
*.so
*.dylib
*.o
*.a
compile_commands.json
python/credit/pycredit*.so
python/credit/pycredit*.dylib
python/credit/pycredit*.pyd
